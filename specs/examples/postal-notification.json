  "subject": {
    "en": "Revised tariff for inland post cards and acknowledgement cards with effect from 1st October 1947"
  },
  "body": [
    {
      "type": "paragraph",
      "number": "1.",
      "text": { "en": "In exercise of the powers conferred by the Indian Post Office Act, the Governor General in Council is pleased to direct that the rates set out in the Schedule below shall come into force on and from the 1st October 1947." }
    },
    {
      "type": "paragraph",
      "number": "2.",
      "text": { "en": "All Heads of Circles shall arrange for the immediate display of this Notification at every post office and shall ensure that existing stocks are over-stamped with the revised denominations until fresh supplies are received from the Central Stamp Store." }
    },
    {
      "type": "table",
      "columns": [ { "en": "Article" }, { "en": "Former Rate" }, { "en": "Revised Rate" } ],
      "rows": [
        [ { "en": "Single inland post card" }, { "en": "9 pies" }, { "en": "6 pies" } ],
        [ { "en": "Reply post card" }, { "en": "1 anna 6 pies" }, { "en": "1 anna" } ],
        [ { "en": "Acknowledgement card" }, { "en": "9 pies" }, { "en": "6 pies" } ]
      ]
    },
    {
      "type": "paragraph",
      "number": "3.",
      "text": { "en": "Any post card posted on or after the appointed day bearing the former rate shall be charged with deficient postage in the usual manner." }
    }
  ],
  "signature": {
    "name": "R. K. Menon",
    "designation": { "en": "for Director General, Posts and Telegraphs" },
    "style": "ink"
  },
